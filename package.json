{
  "name": "dsh-todo",
  "version": "0.3.2",
  "type": "module",
  "description": "DSH 待办清单：左侧导航、Agent 工具与可置顶的独立窗口。",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "native",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "plugin-settings.js",
    "settings-ui.js",
    "scripts/build-settings.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs && npm run build:settings",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/build.mjs --check",
    "test:contracts": "node scripts/check-contracts.mjs",
    "test:electron": "node scripts/electron-smoke.mjs",
    "build:settings": "node scripts/build-settings.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsakuraAOI/dsh-todo.git"
  },
  "homepage": "https://github.com/AsakuraAOI/dsh-todo#readme",
  "bugs": {
    "url": "https://github.com/AsakuraAOI/dsh-todo/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "pluginPage": {
    "name": "dsh-todo",
    "title": "待办清单",
    "route": "/api/plugins/dsh-todo/settings",
    "titles": {
      "kasumi-retry": "Kasumi 重试与续写",
      "hiagent-global": "Kasumi 全局适配",
      "hiagent-global-compaction": "全局压缩",
      "hiagent-observability": "性能观测",
      "hiagent-recovery": "恢复保护",
      "hiagent-query-budget": "请求预算",
      "bilibili-account": "B站账号与视频阅读",
      "hiagent-web-search": "网页搜索与读取",
      "seeit-video": "Seeit 视频理解",
      "session-md-export": "导出选项",
      "kasumiflow": "学习事务与课程资料"
    }
  }
}
